{
	"name": "svelte-table-views-tanstack",
	"version": "0.1.4",
	"description": "Save and restore table view configurations (filters, sorting, columns) with TanStack DB persistence. Built for Svelte 5 apps using the TanStack stack. Features reactive queries, local-first storage with IndexedDB, and seamless integration with TanStack Table.",
	"keywords": [
		"svelte",
		"table",
		"views",
		"saved-views",
		"table-configuration",
		"filters",
		"sorting",
		"columns",
		"persistence",
		"tanstack-db",
		"tanstack-table",
		"svelte-table-kit"
	],
	"author": "Jason (Shotley Builder)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shotleybuilder/svelte-table-views-tanstack.git"
	},
	"bugs": {
		"url": "https://github.com/shotleybuilder/svelte-table-views-tanstack/issues"
	},
	"homepage": "https://github.com/shotleybuilder/svelte-table-views-tanstack#readme",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"peerDependencies": {
		"svelte": "^4.0.0 || ^5.0.0",
		"@tanstack/db": "^0.5.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/postcss": "^4.1.17",
		"@types/eslint": "^9.6.0",
		"autoprefixer": "^10.4.22",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"postcss": "^8.5.6",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"publint": "^0.1.9",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^5.0.0",
		"vitest": "^2.0.0"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
